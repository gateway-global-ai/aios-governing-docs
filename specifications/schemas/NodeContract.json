{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "{{GATEWAY_SCHEMA_BASE_URL}}/node-contract.json",
  "title": "AIOS Node Contract",
  "description": "Defines the strictly bounded execution environment for a specific intent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "version",
    "supported_intents",
    "participating_roles",
    "required_skills",
    "allowed_actions",
    "permitted_ui_components",
    "voice_modes",
    "expected_outcome",
    "performance_budget",
    "telemetry_hooks",
    "policy_tags",
    "state_conflict_weight"
  ],
  "properties": {
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-\\.]{2,80}$",
      "description": "Stable, globally unique node identifier (e.g., hospitality-check-in-v1)."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the node contract."
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "supported_intents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/IntentRef"
      },
      "description": "The exact IntentKeys this node can lawfully handle."
    },
    "participating_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/RoleRef"
      },
      "description": "Roles authorized to participate when this node is active."
    },
    "required_skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SkillRef"
      },
      "description": "Computational capabilities required to produce outcomes."
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ActionRef"
      },
      "description": "MCP endpoints and system actions permitted under this node."
    },
    "required_knowledge_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/KnowledgeSourceRef"
      },
      "description": "Strict whitelist of data sources the node may access."
    },
    "permitted_ui_components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UIComponentRef"
      },
      "description": "Whitelisted shadcn/ui components the Stateful Shell may render. Unlisted components are rejected at compile time."
    },
    "voice_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "voice_ptt",
          "voice_handsfree",
          "chat_only",
          "hybrid_voice_canvas"
        ]
      },
      "description": "Voice and chat modes this node physically supports."
    },
    "expected_outcome": {
      "$ref": "#/$defs/OutcomeSpec"
    },
    "performance_budget": {
      "$ref": "#/$defs/PerformanceBudget"
    },
    "telemetry_hooks": {
      "$ref": "#/$defs/TelemetryHooks"
    },
    "policy_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "description": "Tags evaluated by the Policy Engine (e.g., pii, write_action, external_comm)."
    },
    "state_conflict_weight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Priority weight used by the OS State Conflict Resolution Protocol to resolve deadlocks."
    },
    "journey_phase_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "discovery",
          "consideration",
          "conversion",
          "post_sale",
          "support"
        ]
      },
      "description": "Specific phases where this node is valid."
    }
  },
  "$defs": {
    "IntentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_id"
      ],
      "properties": {
        "intent_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_\\-]{2,60}$"
        },
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.75
        }
      }
    },
    "RoleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id"
      ],
      "properties": {
        "role_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_\\-]{2,60}$"
        },
        "side": {
          "type": "string",
          "enum": [
            "customer",
            "agent",
            "system"
          ]
        }
      }
    },
    "SkillRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id"
      ],
      "properties": {
        "skill_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_\\-]{2,80}$"
        },
        "version_range": {
          "type": "string"
        }
      }
    },
    "ActionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "effect"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_\\-\\.]{2,120}$"
        },
        "effect": {
          "type": "string",
          "enum": [
            "read",
            "write",
            "delete",
            "invoke",
            "render"
          ]
        },
        "requires_confirmation": {
          "type": "boolean",
          "default": false
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "low"
        }
      }
    },
    "KnowledgeSourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "access"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_\\-\\.]{2,80}$"
        },
        "access": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "read"
        }
      }
    },
    "UIComponentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "description": "Canonical shadcn registry item name."
        },
        "variants_allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "OutcomeSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_id",
        "success_criteria"
      ],
      "properties": {
        "outcome_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_\\-]{2,80}$"
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "failure_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 240
          }
        }
      }
    },
    "PerformanceBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p95_end_to_end_ms",
        "p95_first_canvas_ms",
        "max_bundle_kb"
      ],
      "properties": {
        "p95_end_to_end_ms": {
          "type": "integer",
          "minimum": 50,
          "maximum": 60000
        },
        "p95_first_canvas_ms": {
          "type": "integer",
          "minimum": 50,
          "maximum": 60000
        },
        "max_bundle_kb": {
          "type": "integer",
          "minimum": 50,
          "maximum": 5000
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "default": 8
        }
      }
    },
    "TelemetryHooks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_\\-\\.]{2,80}$"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "traces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}