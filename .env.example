# Copy to .env and adjust. Used by scripts (dotenv) for LLM keys and brand placeholders.

# --- LLM (lifecycle, reviews) ---
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# --- Gateway Global public URLs (served documents + schema load) ---
# Main marketing / product site
# GATEWAY_PUBLIC_SITE_URL=http://www.gatewayglobal.ai

# Governance corpus (e.g. docs subdomain)
# GATEWAY_DOCS_SITE_URL=http://docs.gatewayglobal.ai

# JSON Schema $id base; default: {GATEWAY_DOCS_SITE_URL}/schemas
# GATEWAY_SCHEMA_BASE_URL=http://docs.gatewayglobal.ai/schemas

# Component registry JSON URL; default: {GATEWAY_DOCS_SITE_URL}/registry/components.json
# GATEWAY_COMPONENT_REGISTRY_URL=http://docs.gatewayglobal.ai/registry/components.json

# Public roadmap page; default: {GATEWAY_DOCS_SITE_URL}/roadmap
# GATEWAY_ROADMAP_URL=http://docs.gatewayglobal.ai/roadmap

# Council transparency log; default: {GATEWAY_DOCS_SITE_URL}/governance/transparency
# GATEWAY_TRANSPARENCY_URL=http://docs.gatewayglobal.ai/governance/transparency

# Contact emails (referenced from governing markdown)
# GATEWAY_EMAIL_GOVERNANCE=governance@gatewayglobal.ai
# GATEWAY_EMAIL_RFC=rfcs@gatewayglobal.ai
# GATEWAY_EMAIL_VENDOR=vendor@gatewayglobal.ai
# GATEWAY_EMAIL_ONBOARDING=onboarding@gatewayglobal.ai
