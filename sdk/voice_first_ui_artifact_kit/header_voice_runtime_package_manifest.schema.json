{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gatewayglobal.ai/schemas/aios/header_voice_runtime_package_manifest.schema.json",
  "title": "Header Voice Runtime Package Manifest",
  "type": "object",
  "required": [
    "package_id",
    "version",
    "status",
    "package_scope",
    "governing_docs",
    "runtime_files",
    "env_vars",
    "proof_expectations",
    "deployment_steps"
  ],
  "properties": {
    "package_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ratified",
        "superseded"
      ]
    },
    "package_scope": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "governing_docs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "document_id",
          "path"
        ],
        "properties": {
          "document_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "runtime_files": {
      "type": "object",
      "required": [
        "shell_integration",
        "voice_routes",
        "host_transport"
      ],
      "properties": {
        "shell_integration": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "voice_routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "host_transport": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "optional_local_personalization": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "env_vars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "required_when",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "required_when": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "default": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "proof_expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "proof_id",
          "description"
        ],
        "properties": {
          "proof_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "deployment_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step",
          "action"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
